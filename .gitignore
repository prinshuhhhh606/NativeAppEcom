# ==============================================================================
# BHARAT BAZAAR / APPSICAECOM - ROOT MONOREPO .GITIGNORE
# Comprehensive Git ignore rules for React Native, React/Vite, Node.js & Express
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEPENDENCIES & PACKAGE MANAGERS
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# 2. ENVIRONMENT VARIABLES & SECRETS (STRICT SECURITY)
# ------------------------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Preserve example environment template files
!.env.example
!**/.env.example
!.env.sample
!**/.env.sample

# Private credentials, SSL certificates & signing keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.jks
*.keystore
!debug.keystore

# ------------------------------------------------------------------------------
# 3. BUILD OUTPUTS & PRODUCTION BUNDLES
# ------------------------------------------------------------------------------
dist/
**/dist/
build/
**/build/
out/
**/out/
.output/
**/.output/

# ------------------------------------------------------------------------------
# 4. REACT NATIVE & METRO BUNDLER
# ------------------------------------------------------------------------------
.metro-health-check*
*.jsbundle
*.bundle
.expo/
.expo-shared/
web-build/

# ------------------------------------------------------------------------------
# 5. ANDROID PLATFORM ARTIFACTS
# ------------------------------------------------------------------------------
**/android/.gradle/
**/android/build/
**/android/app/build/
**/android/.cxx/
**/android/local.properties
**/android/*.iml
**/android/.kotlin/
**/android/captures/
**/android/app/build.gradle.bak
**/android/build.gradle.bak
**/android/gradle.properties.bak

# Android binary outputs
*.apk
*.aab
*.ap_
*.dex
*.class

# ------------------------------------------------------------------------------
# 6. IOS PLATFORM ARTIFACTS & XCODE
# ------------------------------------------------------------------------------
**/ios/Pods/
**/ios/build/
**/ios/DerivedData/
**/ios/*.xcworkspace/xcuserdata/
**/ios/*.xcodeproj/xcuserdata/
**/ios/*.xcodeproj/project.xcworkspace/xcuserdata/
**/*.xcuserstate
**/.xcode.env.local
**/ios/.xcode.env.local
*.ipa
*.hmap
*.dSYM.zip
*.dSYM

# ------------------------------------------------------------------------------
# 7. LOGS & DIAGNOSTICS
# ------------------------------------------------------------------------------
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 8. TESTING & CODE COVERAGE
# ------------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
*.lcov

# ------------------------------------------------------------------------------
# 9. RUNTIME USER UPLOADS & LOCAL DATABASE ARTIFACTS
# ------------------------------------------------------------------------------
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep
*.sqlite
*.sqlite3
*.db-journal

# ------------------------------------------------------------------------------
# 10. OPERATING SYSTEM & ARTIFACTS
# ------------------------------------------------------------------------------
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
**/Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
NUL
**/NUL

# ------------------------------------------------------------------------------
# 11. IDE & CODE EDITOR CACHES
# ------------------------------------------------------------------------------
.idea/
**/.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ------------------------------------------------------------------------------
# 12. TEMPORARY & BACKUP FILES
# ------------------------------------------------------------------------------
*.bak
*.tmp
*.temp
*~
*.swp
*.swo
.eslintcache
.stylelintcache

